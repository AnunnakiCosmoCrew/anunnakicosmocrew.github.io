---
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>
      &copy; {year} CosmoCrew &mdash; a brand of <a
        class="luvita"
        href="https://luvita.tr/"
        rel="noopener noreferrer"
        target="_blank">Luvita Teknoloji Ltd. &#350;ti.</a
      >
    </p>
    <a href={withBase('privacy')}>Privacy</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sp-8);
    border-top: 1px solid var(--c-border);
    padding-block: var(--sp-5) var(--sp-6);
    color: var(--c-muted);
    font-size: var(--fs-300);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-5);
  }

  .site-footer a {
    color: var(--c-ink-soft);
  }

  /* The Luvita icon beside the company name (luvita-docs/brand/README.md):
     the small drawing, in one colour, taking the link's text colour. It is
     drawn by CSS on purpose. The attribution line in the HTML stays exactly
     the sentence the brand check requires, and a reader without CSS still
     gets the whole line. Never smaller than 16 px; do not recolour it or
     give it the lamp accent. */
  .luvita {
    /* The icon never ends a line apart from the name. */
    white-space: nowrap;
  }

  @supports (mask-image: url('')) or (-webkit-mask-image: url('')) {
    .luvita::before {
      content: '';
      display: inline-block;
      width: max(16px, 1.2em);
      height: max(16px, 1.2em);
      margin-inline-end: 0.25em;
      vertical-align: -0.28em;
      background-color: currentColor;
      -webkit-mask: url('../assets/brand/luvita-icon-small.svg') center / contain no-repeat;
      mask: url('../assets/brand/luvita-icon-small.svg') center / contain no-repeat;
    }
  }
</style>
