---
import { withBase } from '../lib/url';

// The home page sections (DESIGN.md section 5). From any other page these
// lead back to the home page's sections.
const home = withBase('');
const navItems = [
  { label: 'Apps', href: `${home}#apps` },
  { label: 'Fair terms', href: `${home}#fair-terms` },
  { label: 'Contact', href: `${home}#contact` },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home}>CosmoCrew</a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-5) var(--sp-3);
  }

  .brand {
    color: var(--c-ink);
    font-size: var(--fs-500);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    list-style: none;
    padding: 0;
  }

  .site-nav a {
    color: var(--c-ink-soft);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--c-accent);
  }
</style>
